# ==============================================================================
# Standard Blacklist .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Temporary / Debug artifacts
*.tmp
*.bak

# Firebase local
.firebase/
firebase-debug.log

# Apify local storage
apify_storage_local/

# Local caches (runtime artifacts, not source)
cache/
local_cache/
test_cache/
output/
debug_output/

# Firestore backup/temp
firestore.rules.backup
firestore.rules.temp

# ==============================================================================
# Root files — ignore everything except LICENSE, README, CHANGELOG, requirements
# ==============================================================================

# Ignore all root files by default
/*
# Keep only these
!/.gitignore
!/.dockerignore
!/CLAUDE.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/CHANGELOG.md
!/requirements.txt
!/setup.py
!/pytest.ini
!/Dockerfile
!/docker-compose.yml
!/.env.example

# Track source and config directories
!/api/
!/frontend/
!/universal_scraper/
!/tests/
!/.github/
