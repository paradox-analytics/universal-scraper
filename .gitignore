# ==============================================================================
# STRICT WHITELIST APPROACH
# ==============================================================================

# 1. Ignore EVERYTHING by default
/*
!/

# 2. Whitelist Core Directories (Everything inside these is tracked unless ignored below)
!/api/
!/frontend/
!/universal_scraper/

# 3. Whitelist Essential Documentation & Config
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/CHANGELOG.md
!/requirements.txt
!/setup.py

# ==============================================================================
# STANDARD IGNORES (Apply to content within whitelisted directories)
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
.pytest_cache/
.coverage
htmlcov/
*.log

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
.DS_Store

# IDEs
.vscode/
.idea/
*.swp

# Temporary / Debug Files
*.tmp
*.bak
test_*.json
test_output_*.txt
debug_*.json
debug_*.html
