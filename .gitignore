# ==============================================================================
# Standard Blacklist .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Temporary / Debug artifacts
*.tmp
*.bak

# Firebase local
.firebase/
firebase-debug.log

# Apify local storage
apify_storage_local/

# Local caches (runtime artifacts, not source)
cache/
local_cache/
test_cache/
output/
debug_output/

# Firestore backup/temp
firestore.rules.backup
firestore.rules.temp
