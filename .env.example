# Universal Scraper Environment Variables
# Copy this file to .env and fill in your values

# AI Provider API Keys (choose one or multiple)
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Proxy Configuration (optional)
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
BRIGHTDATA_PROXY_USER=your-brightdata-username
BRIGHTDATA_PROXY_PASS=your-brightdata-password

# Web Unblocker (optional, for anti-bot sites)
WEB_UNBLOCKER_API_KEY=your-web-unblocker-key
WEB_UNBLOCKER_ZONE=web_unlocker1
WEB_UNBLOCKER_CUSTOMER_ID=your-customer-id

# Firebase (backend token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Cache Configuration
CACHE_DIR=./cache
CACHE_TTL=86400

# Redis (optional, required for multi-tenant rate limiting)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
