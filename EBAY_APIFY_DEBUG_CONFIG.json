{
  "mode": "scrape",
  "urls": ["https://www.ebay.com/sch/i.html?_nkw=laptop"],
  "scrapeConfig": {
    "fields": ["title", "price"]
  },
  "browserConfig": {
    "useCamoufox": true,
    "headless": true,
    "timeout": 60000
  },
  "proxyConfiguration": {
    "useApifyProxy": true,
    "apifyProxyGroups": ["RESIDENTIAL"]
  },
  "apiKeys": {
    "openaiApiKey": "YOUR_KEY"
  },
  "debug": {
    "saveHtml": true,
    "verboseLogs": true
  }
}





